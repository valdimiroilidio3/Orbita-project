# ─────────────────────────────────────────────────────────────
# ORBITA CHAT — modelo de variáveis de ambiente
# Copia para apps/web/.env.local e preenche com credenciais reais.
# Este ficheiro NÃO contém credenciais e não ativa integrações.
# Documentação: docs/authentication.md
# ─────────────────────────────────────────────────────────────

# ── 1. Configuração PÚBLICA do Supabase (exposta ao browser por design) ──
# URL do projeto e chave "anon"/publishable. Protegidas por RLS na base de
# dados — nunca contêm privilégios administrativos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 2. SEGREDOS exclusivos do SERVIDOR (nunca usar NEXT_PUBLIC_) ──
# Apenas para operações administrativas raras (ex.: scripts de seed).
# NÃO é necessária para operações normais: a sessão autenticada + RLS chegam.
# Nunca é exposta ao browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── 3. Reservadas para fases futuras (opcionais, não usadas nesta fase) ──
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Billing — futura integração ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
