# ─────────────────────────────────────────────────────────────
# ORBITA CHAT — variáveis de ambiente do apps/web
# Copia para .env.local e preenche com credenciais reais do Supabase.
# Guia completo: docs/authentication.md («Configuração local»)
# ─────────────────────────────────────────────────────────────

# ── 1. Configuração PÚBLICA (visível no browser por design) ──
# Protegida por RLS. Sem estas variáveis, a app corre em modo de
# demonstração com aviso explícito — a autenticação NUNCA é simulada.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 2. SEGREDOS do SERVIDOR (apenas server components/actions/rotas) ──
# Opcional: não é necessária para operações normais (sessão + RLS chegam).
# Usada apenas pela ingestão de webhooks de voz no servidor.
# NUNCA usar prefixo NEXT_PUBLIC_ ne# ── 3. Motor de voz / telefonia (Prompt 07) — integração PENDENTE ──
# Sem credenciais reais, o motor de voz apresenta o estado «Não configurado»
# e NADA é criado nem simulado. Ver docs/voice-setup.md (onde obter cada
# variável) e docs/voice-architecture.md (decisão técnica).
# Nenhuma destas variáveis pode ter prefixo NEXT_PUBLIC_ (segredos de servidor).

# Fornecedor de voz em tempo real: pending | openai-realtime | twilio
VOICE_PROVIDER=pending
# Fornecedor telefónico: pending | sip | twilio
TELEPHONY_PROVIDER=pending

# OpenAI — voz em tempo real (quando VOICE_PROVIDER=openai-realtime)
# Obter em: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Segredo de assinatura dos webhooks do fornecedor de voz (se aplicável)
OPENAI_WEBHOOK_SECRET=

# Segredo de verificação de assinatura dos webhooks telefónicos (obrigatório
# com TELEPHONY_PROVIDER != pending) — configurado no painel do fornecedor
TELEPHONY_WEBHOOK_SECRET=

# Twilio (apenas quando TELEPHONY_PROVIDER=twilio)
# Obter em: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Base pública dos webhooks (URL exposta pelo fornecedor para callbacks)
PUBLIC_WEBHOOK_BASE_URL=

# Limites operacionais do motor de voz (opcionais — defaults documentados)
VOICE_CALL_MAX_DURATION_SECONDS=
VOICE_CALL_TRANSIENT_TIMEOUT_MIN=
VOICE_WEBHOOK_MAX_PAYLOAD_BYTES=
VOICE_WEBHOOK_REPLAY_WINDOW_SECONDS=

# ── 4. Reservadas para fases futuras ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
