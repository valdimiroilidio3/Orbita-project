{
  "name": "orbita-chat",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "pnpm --filter @orbita/web dev",
    "build": "pnpm --filter @orbita/web build",
    "start": "pnpm --filter @orbita/web start",
    "lint": "pnpm --filter @orbita/web lint",
    "typecheck": "pnpm --filter @orbita/web typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @orbita/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
